# ─────────────────────────────────────────────────────────────
# Azure DevOps baglanti ayarlari
# ─────────────────────────────────────────────────────────────
# BULUT (Azure DevOps Services):
#   AZDO_BASE_URL=https://dev.azure.com/<org>
# ON-PREM (Azure DevOps Server / TFS):
#   AZDO_BASE_URL=https://tfs.sirket.local/DefaultCollection
#   (veya https://azuredevops.sirket.local/<Collection>)
AZDO_BASE_URL=https://dev.azure.com/<org>
AZDO_PROJECT=<proje-adi>

# Kimlik dogrulama: Personal Access Token (Basic auth ile gonderilir).
# Pipeline icinden calistiginda bunun yerine System.AccessToken kullanilir
# (AZDO_BEARER_TOKEN olarak otomatik gecirilir, bkz. azure-pipelines/analyze-on-failure.yml).
AZDO_PAT=<personal-access-token>

# Pipeline icindeki adim System.AccessToken'i buraya verir (PAT yerine Bearer).
# Bos birakilabilir; doldurulursa PAT'in onune gecer.
# AZDO_BEARER_TOKEN=

# REST API versiyonu. Bulut icin 7.1 onerilir.
# ON-PREM icin sunucu surumune gore dusurun:
#   Azure DevOps Server 2022 -> 7.0,  2020 -> 6.0,  2019 -> 5.0
AZDO_API_VERSION=7.1

# Self-signed sertifikali on-prem kurulumlarda dogrulamayi kapatmak icin "false".
AZDO_VERIFY_SSL=true

# ─────────────────────────────────────────────────────────────
# Yerel LLM (OpenAI uyumlu endpoint: Ollama / vLLM / LM Studio / llama.cpp)
# ─────────────────────────────────────────────────────────────
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5-coder:14b
# Cogu yerel sunucu icin gereksizdir; gerekiyorsa doldurun.
LLM_API_KEY=ollama
# Ajan dongusunde izin verilen azami arac cagrisi turu.
LLM_MAX_TOOL_ITERATIONS=8

# ─────────────────────────────────────────────────────────────
# Webhook (Service Hook alicisi)
# ─────────────────────────────────────────────────────────────
# Bos ise dogrulama yapilmaz. Doldurursaniz gelen istekteki
# Authorization: Basic ... veya ?token= ile eslesmesi beklenir.
WEBHOOK_SECRET=
